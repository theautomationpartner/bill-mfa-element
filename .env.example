# Plantilla. Hay dos perfiles y cada uno tiene su propio archivo:
#
#   .env.sandbox   node server.js          (por defecto)
#   .env.live      node server.js live
#
# Las claves son las mismas en los dos; solo cambian los valores.

# sandbox | production
BILL_ENV=sandbox

# --- Credenciales BILL (POST /v3/login) -------------------------------------
# devKey: Settings > Sync & Integrations > Developer Key en la web app de BILL.
# OJO: el devKey de sandbox NO sirve en produccion, son organizaciones distintas.
BILL_DEV_KEY=
# username: email del usuario BILL. Debe ser ADMINISTRATOR.
BILL_USERNAME=
BILL_PASSWORD=
# organizationId: lo devuelve GET /v3/login/session o la propia respuesta de login
BILL_ORG_ID=

# --- Zapier -----------------------------------------------------------------
# La URL del Catch Hook es un secreto: cualquiera que la conozca puede inyectar
# datos en el Zap. Nunca la subas al repositorio.
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/XXXXXXXX/XXXXXXX/

# --- App --------------------------------------------------------------------
PORT=3000

# Plantilla. Hay dos perfiles y cada uno tiene su propio archivo:
#
#   .env.sandbox   node server.js          (por defecto)
#   .env.live      node server.js live
#
# Las claves son las mismas en los dos; solo cambian los valores.

# sandbox | production
BILL_ENV=sandbox

# --- Credenciales BILL (POST /v3/login) -------------------------------------
# devKey: Settings > Sync & Integrations > Developer Key en la web app de BILL.
# OJO: el devKey de sandbox NO sirve en produccion, son organizaciones distintas.
BILL_DEV_KEY=
# username: email del usuario BILL. Debe ser ADMINISTRATOR.
BILL_USERNAME=
BILL_PASSWORD=
# organizationId: lo devuelve GET /v3/login/session o la propia respuesta de login
BILL_ORG_ID=

# --- Zapier -----------------------------------------------------------------
# La URL del Catch Hook es un secreto: cualquiera que la conozca puede inyectar
# datos en el Zap. Nunca la subas al repositorio.
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/XXXXXXXX/XXXXXXX/

# --- Modo de prueba (opcional) ----------------------------------------------
# Mismo devKey y organizacion; otro USUARIO de BILL (otro telefono) y otro
# webhook. Se entra con https://<app>/?test=<TEST_MODE_KEY> y se sale con ?test=off.
# Sin las tres primeras variables el modo no existe.
TEST_MODE_KEY=
# Usuario de prueba. Tambien debe ser ADMINISTRATOR en la organizacion.
TEST_BILL_USERNAME=
TEST_BILL_PASSWORD=
# Catch Hook SEPARADO. No reutilices ZAPIER_WEBHOOK_URL: el rememberMeId de
# este usuario no sirve para el login del Zap de los jueves y pisaria el bueno.
TEST_ZAPIER_WEBHOOK_URL=

# Muestra el panel "Test mode trace" tambien sin ?test=. Solo para la rama dev
# (sandbox); en produccion dejalo sin definir.
SHOW_TRACE=

# --- Flujo MFA (opcional) ---------------------------------------------------
# Clave para cifrar el token del flujo entre "enviar SMS" y "validar codigo".
# Si falta, se deriva de los secretos de BILL ya configurados. Debe ser la
# misma en todas las instancias (en Vercel lo es: son variables del proyecto).
APP_SECRET=
# Vigencia del rememberMeId, solo para informar la fecha de vencimiento.
REMEMBER_ME_DAYS=30

# --- App --------------------------------------------------------------------
PORT=3000
